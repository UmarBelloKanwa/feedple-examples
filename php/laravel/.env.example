APP_NAME="Laravel Feedple Example"
APP_ENV=local
APP_KEY=base64:feedpleexamplekey12345678901234567890123=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Feedple Workspace Configuration
FEEDPLE_API_KEY=sk_live_your_workspace_api_key_here
FEEDPLE_WIDGET_PUBLIC_KEY=wpk_your_widget_public_key_here

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
