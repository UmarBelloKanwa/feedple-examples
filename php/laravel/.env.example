APP_NAME="Laravel Feedple Example"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

SESSION_DRIVER=file

# Feedple Workspace Configuration
FEEDPLE_API_KEY=sk_live_your_workspace_api_key_here
FEEDPLE_WIDGET_PUBLIC_KEY=wpk_your_widget_public_key_here

# Database Configuration Examples:

# 1. SQLite (Default)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# 2. MySQL / MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_database_name
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_database_password

# 3. PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=your_database_name
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_database_password
